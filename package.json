{
  "name": "comparateur",
  "version": "1.0.0",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "deploy": "astro build && wrangler deploy",
    "cf-typegen": "wrangler types",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "db:seed:local": "wrangler d1 execute DB --local --file=seed/dev.sql",
    "db:seed:remote": "wrangler d1 execute DB --remote --file=seed/dev.sql",
    "test": "node --experimental-strip-types --disable-warning=ExperimentalWarning --test tests/*.test.mjs"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.3.4",
    "astro": "^7.3.8"
  },
  "devDependencies": {
    "typescript": "^7.0.2",
    "wrangler": "^4.149.0"
  },
  "private": true,
  "type": "module"
}
