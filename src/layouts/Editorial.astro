---
import Base from './Base.astro';
interface Props { title: string; intro: string; eyebrow?: string }
const { title, intro, eyebrow = 'Le comparateur, en toute transparence' } = Astro.props;
---
<Base title={`${title} — Comparateur`} description={intro}>
  <main id="contenu" class="container reading-page"><span class="eyebrow">{eyebrow}</span><h1>{title}</h1><p class="intro">{intro}</p><slot /></main>
</Base>
